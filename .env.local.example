# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore - never commit real keys.

# Server-only key, used by lib/api-football.ts for direct REST calls
# (fixtures/statistics, injuries, predictions, etc). Never expose this
# to the browser - do NOT prefix it with NEXT_PUBLIC_.
API_FOOTBALL_KEY= your-real-widget-key-here

# Public key used by the api-sports-widget script tags in the browser.
# This one IS visible in page source by design - restrict it to your
# domain(s) in the API-Sports dashboard, and keep it separate from the
# server key above so a scraped widget key can't burn your backend's quota.
NEXT_PUBLIC_API_FOOTBALL_WIDGET_KEY= your-real-widget-key-here
